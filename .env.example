# Copy this file to `.env` and fill in what you have. Every value is optional.
# Anything left blank simply keeps that feature in its safe fallback state.
# VITE_ values are bundled into the public site, so NEVER put secret keys here.

# ── Booking requests and contact form ─────────────────────────────────────────
# Where booking requests and contact messages are sent from the page.
# Blank = FormSubmit (formsubmit.co) forwards them to the business email in
# src/config/site.js. Anne must confirm that address once, see the README.
# Or set any service URL that accepts a JSON POST, for example a Formspree form.
VITE_FORM_ENDPOINT=

# Booking helper: the web app address from backend/Code.gs (see the README,
# "Bookings and confirmation emails"). When set, the calendar hides times that
# are taken, holds a time while someone pays, and clients get a confirmation
# email. Bookings and contact messages then go through it instead of FormSubmit.
VITE_BOOKING_API_URL=

# Card and M-Pesa through Paystack. Set to true AFTER the booking helper is set up and its
# Paystack secret key is saved in the helper (README, "Paystack"). The M-Pesa and Card
# choices then both open Paystack's secure page, and payments are checked automatically.
VITE_PAYSTACK=false

# Anne's WhatsApp number, with or without the country code (0712 345 678 or
# 254712345678). Blank = no WhatsApp button.
VITE_WHATSAPP_NUMBER=

# ── Payments ──────────────────────────────────────────────────────────────────
# Shown to visitors only while previewing. `npm run dev` is always in demo mode.
# Set to true to preview the full simulated payment flow on a deployed site.
# (Visitors can also add ?demo=payments to the page address.)
# Demo mode never moves money and never sends a booking to Anne.
VITE_DEMO_PAYMENTS=false

# M-Pesa, option A: manual payment (works with no server).
# Visitors pay to your Till or Paybill, then enter the M-Pesa confirmation code.
# Fill in ONE of these.
VITE_MPESA_TILL=
VITE_MPESA_PAYBILL=
# Paybill only: the fixed account number clients must enter (for a bank paybill
# such as NCBA's 880100 this is the bank account number). Blank = booking reference.
VITE_MPESA_ACCOUNT=

# M-Pesa, option B: automatic prompt on the visitor's phone (needs a small server).
# Base URL of your backend that implements the endpoints in the README.
VITE_API_BASE_URL=

# Visa / Mastercard: card details are always entered on your payment provider's
# own secure page, never on this site.
# Either a static payment link (Pesapal, Flutterwave, DPO and so on)...
VITE_CARD_CHECKOUT_URL=
# A payment link has one fixed amount, so the 5-session package needs its own link
# (KSh 23,750 with the default prices). Without it, card is not offered for packages.
VITE_CARD_CHECKOUT_URL_PACKAGE=
# ...or set this to true to create a checkout per booking through your backend
# (needs VITE_API_BASE_URL and a POST {API}/card/checkout endpoint).
VITE_CARD_CHECKOUT_VIA_API=false

# Asset paths are relative by default, so GitHub Pages project sites and custom
# domains both work with no setting. Only set this if a host needs an absolute
# sub-path.
# VITE_BASE_PATH=/radiance-coaching/
